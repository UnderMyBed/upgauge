# Data — never committed. raw/ is the audit trail but lives on disk/R2, not git.
/data/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node (app/, from M3)
node_modules/
.next/
out/
app/node_modules/
app/.next/

# Build artifacts
*.duckdb
*.duckdb.wal

# Implementation plans are working artifacts for the subagent loop, not docs.
# Durable decisions belong in docs/ — see the working agreements in CLAUDE.md.
docs/superpowers/plans/
docs/superpowers/specs/
.superpowers/

# Env. No leading slash, so this matches at ANY depth -- deploy/.env, the operator's five
# provisioning credentials, is covered by it. Tightening to /.env would silently expose them;
# test_the_credential_file_is_gitignored asserts otherwise. deploy/.env.example is the
# committed template and is deliberately NOT matched.
.env
.env.local

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
